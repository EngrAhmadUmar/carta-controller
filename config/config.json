{
    "$schema": "./config_schema.json",
    "authProviders": {
        "ldap": {
            "publicKeyLocation": "/home/mona/carta-controller-new/config/carta_public.pem",
            "privateKeyLocation": "/home/mona/carta-controller-new/config/carta_private.pem",
            "issuer": "carta.local",
            "keyAlgorithm": "RS256",
            "accessTokenAge": "15m",
            "refreshTokenAge": "1w",
            "ldapOptions": {
                "url": "ldap://localhost:389",
                "searchBase": "ou=users,dc=nodomain",
                "searchFilter": "uid={{username}}",
                "starttls": false,
                "reconnect": true,
                "bindProperty": "dn",
                "searchScope": "sub",
                "strictDN": true
            }
        }
    },
    "database": {
        "uri": "mongodb://localhost:27017",
        "databaseName": "carta"
    },
    "serverPort": 3003,
    "serverInterface": "localhost",
    "processCommand": "/home/mona/CARTA/carta-backend/build/carta_backend",
    "killCommand": "/home/mona/carta-controller-new/scripts/carta_kill_script.sh",
    "rootFolderTemplate": "/home/mona/carta-controller-new/data/{username}",
    "baseFolderTemplate": "/home/mona/carta-controller-new/data/{username}",
    "logFileTemplate": "/home/mona/carta-controller-new/logs/{username}_{pid}_{datetime}.log",
    "additionalArgs": ["--no_frontend", "--no_database"],
    "preserveEnv": true,
    "dashboard": {
        "bannerColor": "#d2dce5",
        "backgroundColor": "#f6f8fa",
        "bannerImage": "/home/mona/carta-controller-new/public/images/carta_logo.svg",
        "infoText": "Welcome to the CARTA server.",
        "loginText": "<span>Please enter your login credentials:</span>",
        "footerText": "<span>If you have any problems, comments or suggestions, please contact the system administrator.</span>"
    }
} 